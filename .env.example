# ProfileFleet keeps real proxy values out of profile metadata.
PROFILEFLEET_PROXY_RESEARCH=http://username:password@proxy.example:8080

# Optional CloakBrowser upstream license. ProfileFleet never persists it.
# CLOAKBROWSER_LICENSE_KEY=cb_xxxxxxxx

# Optional runtime overrides.
# PROFILEFLEET_HOME=/absolute/path/to/profilefleet-data
# PROFILEFLEET_PORT=47110
# PROFILEFLEET_MAX_CONCURRENT=1
